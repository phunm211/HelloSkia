<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <!-- Header bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:background="#E0E0E0">

        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Android TextView"
            android:textStyle="bold"
            android:textColor="#333333"
            android:textSize="16sp" />

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="#BBBBBB" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Skia (3 Textures)"
            android:textStyle="bold"
            android:textColor="#333333"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- Main Content: 2 Columns -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <!-- Left Column: Android TextViews (3 Cells) -->
        <LinearLayout
            android:id="@+id/leftColumn"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Row 1: Normal -->
            <TextView
                android:id="@+id/tvNormal"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@drawable/cell_border"
                android:fontFamily="sec"
                android:gravity="center"
                android:text="@string/sample_cell_text"
                android:textColor="#1976D2"
                android:textSize="38sp"
                android:textStyle="normal" />

            <!-- Row 2: Bold -->
            <TextView
                android:id="@+id/tvBold"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@drawable/cell_border"
                android:fontFamily="sec"
                android:gravity="center"
                android:text="@string/sample_cell_text"
                android:textColor="#1976D2"
                android:textSize="38sp"
                android:textStyle="bold" />

            <!-- Row 3: Bold Italic -->
            <TextView
                android:id="@+id/tvBoldItalic"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@drawable/cell_border"
                android:fontFamily="sec"
                android:gravity="center"
                android:text="@string/sample_cell_text"
                android:textColor="#1976D2"
                android:textSize="38sp"
                android:textStyle="bold|italic" />
        </LinearLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="#CCCCCC" />

        <!-- Right Column: Skia SurfaceView -->
        <SurfaceView
            android:id="@+id/surfaceView"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />
    </LinearLayout>

</LinearLayout>
